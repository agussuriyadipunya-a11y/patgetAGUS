# ==========================================
# Payment Gateway Kiosk - Environment Config
# ==========================================

# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Application Secret
ADMIN_DEFAULT_PIN=123456

# Firebase Admin SDK Configuration (Server-side ONLY)
# CATATAN KEAMANAN:
# - Jangan pernah menambahkan prefix NEXT_PUBLIC_ pada variabel rahasia ini.
# - Jangan unggah berkas kredensial service account (*.json) ke repositori git.
# - Pilihan 1: Tentukan path ke berkas JSON service account lokal
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# - Pilihan 2: Konfigurasi variabel individual jika di-deploy di cloud/container
FIREBASE_PROJECT_ID=paygateagus
FIREBASE_DATABASE_URL=https://paygateagus-default-rtdb.asia-southeast1.firebasedatabase.app
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@paygateagus.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
